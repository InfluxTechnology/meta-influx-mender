uuu_version 1.2.39

SDP: boot -f files/u-boot-imx8mm-smart.bin
# This command will be run when use SPL
SDPV: write -f files/u-boot-imx8mm-smart.bin -offset 0x57c00
SDPV: jump

# This command will be run when ROM support stream mode
SDPS: boot -f files/u-boot-imx8mm-smart.bin

# Flash file systems and then the bootloader
FB: ucmd setenv fastboot_dev mmc
FB: ucmd setenv mmcdev ${emmc_dev}
FB: ucmd mmc dev ${emmc_dev}
FB: flash -raw2sparse all files/imx8mm-smart.sdimg
FB: ucmd mmc partconf ${emmc_dev} 1 7 0

FB: ucmd setenv bootdelay 0
FB: ucmd setenv extra_bootargs quiet
FB: ucmd setenv args_from_script quiet

# Type here your mender and local WIFI settings
FB: ucmd setenv local_mender_server 'https://eu.hosted.mender.io'
FB: ucmd setenv local_mender_token '7L4tjYsIn2jRsev2bofJkqCBryBP8EtpQZlwBD-9RxQ'
FB: ucmd setenv local_wifi_ssid ''
FB: ucmd setenv local_wifi_psk ''

FB: ucmd saveenv

FB: done

